# Set these in the shell; Pi does not automatically load .env files.
# Native login through /login is the default. No API key or bridge required.
WORKBUDDY_MODE=native
WORKBUDDY_GZIP=1

# Experimental: enable only after reviewing/installing the optional Pendant tooltip adapter.
# Otherwise leave disabled and use /workbuddy-tooltip on explicitly in a patched Pendant session.
# WORKBUDDY_PENDANT_TOOLTIP=1

# Optional legacy bridge mode only:
# WORKBUDDY_MODE=bridge
# WORKBUDDY_BASE_URL=http://127.0.0.1:8787/v1
# WORKBUDDY_API_KEY=your-local-bridge-key
# WORKBUDDY_MODELS=auto
# WORKBUDDY_CONTEXT_WINDOW=32768
# WORKBUDDY_MAX_TOKENS=4096
# WORKBUDDY_TIMEOUT_MS=3000
